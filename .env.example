# ------------------------------------------------------------------
# AI_Analyst — standalone Investment Committee app
# Copy to `.env` and adjust only if your setup differs from the defaults.
# The app already works on these defaults if a local Postgres `xbrl_sec`
# database is running and PGPASSWORD + DEEPSEEK_API_KEY are set as user
# environment variables (the launcher reads those from your environment).
# ------------------------------------------------------------------

# --- Database (the existing, read-only Postgres warehouse — NOT copied) ---
# Async pool used by the FastAPI backend (pydantic-settings reads DATABASE_URL):
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/xbrl_sec
DB_SCHEMA=sec
# Sync psycopg2 path used by the committee engine (xbrl_sec data layer):
XBRL_SEC_DATABASE_URL=postgresql://postgres@127.0.0.1:5432/xbrl_sec
XBRL_SEC_SCHEMA=sec
# Postgres password is read from the PGPASSWORD environment variable (not stored here).

# --- CORS (frontend dev origin) ---
ALLOWED_ORIGINS=http://localhost:3027,http://127.0.0.1:3027

# --- Frontend -> API base URL ---
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8027

# --- This standalone API never migrates the shared DB ---
MZQA_SKIP_SCHEMA=1

# ------------------------------------------------------------------
# --- Quant / qlib integration (api/quant/*, /api/quant/* router) ---
# Directory where trained alpha-model artifacts are read/written
# (default: <project>/output/quant_models). Train with:
#   python -m api.quant.qlib_alpha train --jurisdiction US --start 2022-01-01
# QLIB_ALPHA_MODEL_DIR=C:\path\to\quant_models
# Cache TTL (seconds) for the latest alpha cross-section and regime-IC weights.
# QLIB_ALPHA_CACHE_TTL=3600
# QLIB_IC_WEIGHTS_CACHE_TTL=3600

# ------------------------------------------------------------------
# --- LLM providers ---
# Five providers are supported. Users normally paste their own key under Setup
# in the app (held in the browser session only, erased when the browser closes);
# these server-side keys are the fallback when no browser key is present.
# Each is also read from the matching user env var / Windows registry entry.
# On Windows these are read straight from your USER environment variables
# (HKCU\Environment), so a key set via System Properties is picked up without
# restarting the backend. Each provider accepts more than one name:
# DEEPSEEK_API_KEY=sk-your-key-here
# OPENAI_API_KEY=sk-proj-your-key-here      # or CHATGPT_API_KEY
# ANTHROPIC_API_KEY=sk-ant-your-key-here    # or CLAUDE_API_KEY
# MOONSHOT_API_KEY=sk-your-key-here         # or KIMI_API_KEY
# GEMINI_API_KEY=AIza-your-key-here         # or GOOGLE_API_KEY

# Provider used when a request does not name one (and by the server-only jobs:
# ETF stories, coverage report, macro brief, institutional narrative).
# One of: deepseek | openai | anthropic | moonshot | gemini
# AI_ANALYST_LLM_PROVIDER=deepseek
